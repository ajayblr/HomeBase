<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One typeface (Inter) everywhere, in a small set of sizes and weights -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textViewStyle">@style/Text</item>
        <item name="android:alertDialogTheme">@style/HomeBaseDialog</item>
    </style>

    <style name="HomeBaseDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textViewStyle">@style/Text.Dialog</item>
    </style>

    <style name="Text" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:shadowColor">#59000000</item>
        <item name="android:shadowRadius">10</item>
    </style>

    <style name="Text.Dialog">
        <item name="android:shadowRadius">0</item>
    </style>

    <!-- Big clock: light weight, tight -->
    <style name="Text.Clock">
        <item name="android:textSize">80sp</item>
        <item name="android:textFontWeight">300</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Temp">
        <item name="android:textSize">60sp</item>
        <item name="android:textFontWeight">300</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.TempSmall">
        <item name="android:textSize">40sp</item>
        <item name="android:textFontWeight">300</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">18sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Small">
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Eyebrow">
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.RowTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Hint">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <!-- Focusable pill button (Sleep timer, Inputs) -->
    <style name="Text.Chip">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:drawableTint">@color/chip_text</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:shadowRadius">0</item>
    </style>

    <style name="Text.Pill">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
