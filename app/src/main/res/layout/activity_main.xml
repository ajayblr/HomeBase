<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg">

    <!-- Backgrounds (only one is visible at a time) -->
    <com.homebase.tvlauncher.RainView
        android:id="@+id/rain"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.homebase.tvlauncher.AuroraView
        android:id="@+id/aurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.homebase.tvlauncher.PhotoWall
        android:id="@+id/photos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/rows_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingEnd="64dp">

            <!-- Top shelf: clock on the left, weather on the right -->
            <LinearLayout
                android:id="@+id/top_shelf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="28dp"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        style="@style/Text.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextClock
                        android:id="@+id/clock"
                        style="@style/Text.Clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm" />

                    <TextClock
                        android:id="@+id/date"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEEE d MMMM"
                        android:format24Hour="EEEE d MMMM" />

                    <!-- Quick buttons: sleep timer and input picker -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:clipChildren="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_sleep"
                            style="@style/Text.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_timer_small"
                            android:text="@string/sleep_timer" />

                        <TextView
                            android:id="@+id/chip_inputs"
                            style="@style/Text.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:drawableStart="@drawable/ic_input_small"
                            android:text="@string/inputs" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right column: compact weather, then upcoming appointments -->
                <LinearLayout
                    android:layout_width="440dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/weather_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/glass_card"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="12dp"
                        android:visibility="invisible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/weather_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textSize="30sp" />

                            <TextView
                                android:id="@+id/weather_temp"
                                style="@style/Text.TempSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/weather_text"
                                    style="@style/Text.CardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/weather_range"
                                    style="@style/Text.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/weather_place"
                                style="@style/Text.Eyebrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/weather_hours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- Upcoming appointments (Subscription Savior) -->
                    <LinearLayout
                        android:id="@+id/appt_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/glass_card"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/Text.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/appt_title"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/appt_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- App rows -->
            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="16dp" />

            <TextView
                style="@style/Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="40dp"
                android:text="@string/hint_hold" />
        </LinearLayout>
    </ScrollView>

    <!-- Small clock that appears top-right once the top shelf scrolls away -->
    <TextClock
        android:id="@+id/mini_clock"
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="64dp"
        android:alpha="0"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm" />
</FrameLayout>
